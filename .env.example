# Copy to .env.local and fill in the values you need. Only OPENAI_API_KEY is
# required; everything else has a sensible default (shown) and can be omitted.
#
# Next.js loads .env.local automatically for `npm run dev`. Never commit
# .env.local — it is git-ignored.

# ─── OpenAI (reward generation) ─────────────────────────────────────────────
# All reward generation goes through OpenAI: dossiers, exact-appearance briefs,
# and image renders. No Google APIs are used.

# Required. https://platform.openai.com/api-keys
# The GPT Image models also need API Organization Verification on your account.
OPENAI_API_KEY=sk-your-key-here

# Text model for dossiers and pre-render appearance briefs (dinosaur / hybrid).
OPENAI_TEXT_MODEL=gpt-5.6-luna

# Image model, output size, and quality for reward renders.
# Size:    e.g. 1024x1024, 1536x1024, 1024x1536, 2048x2048, 3840x2160, auto
# Quality: low | medium | high | auto   (higher = slower + more expensive)
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=medium

# API base URL — only change this if you route through a proxy/gateway.
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── SQLite storage ─────────────────────────────────────────────────────────
# Database files always live under <repo-root>/.sqlite/. Set SQLITE_DB_FILE to
# point both the reward cache and player profiles at one file, or override each
# store separately (SQLITE_DB_FILE takes precedence when both are set).
SQLITE_DB_FILE=division-challenge.sqlite3
# REWARD_CACHE_DB_FILE=division-challenge.sqlite3
# PLAYER_PROFILES_DB_FILE=division-challenge.sqlite3

# ─── Next.js dev server ─────────────────────────────────────────────────────
# Build/dev output directory. Give every concurrently running `next dev` its own
# value to avoid lock collisions on .next/dev/lock (see AGENTS.md), e.g.
#   NEXT_DIST_DIR=.next-dev-3000 npm run dev -- --port 3000
# Usually passed inline rather than set here.
# NEXT_DIST_DIR=.next
