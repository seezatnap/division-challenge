# Copy to .env.local and fill in the values you need. OPENAI_API_KEY is
# required for reward generation; TURSO_* and R2_* are required in production
# (locally they fall back to a SQLite file and a local image directory).
# Everything else has a sensible default (shown) and can be omitted.
#
# Next.js loads .env.local automatically for `npm run dev`. Never commit
# .env.local — it is git-ignored.

# ─── OpenAI (reward generation) ─────────────────────────────────────────────
# All reward generation goes through OpenAI: dossiers, exact-appearance briefs,
# and image renders. No Google APIs are used.

# Required. https://platform.openai.com/api-keys
# The GPT Image models also need API Organization Verification on your account.
OPENAI_API_KEY=sk-your-key-here

# Text model for dossiers and pre-render appearance briefs (dinosaur / hybrid).
OPENAI_TEXT_MODEL=gpt-5.6-luna

# Image model, output size, and quality for reward renders.
# Size:    e.g. 1024x1024, 1536x1024, 1024x1536, 2048x2048, 3840x2160, auto
# Quality: low | medium | high | auto   (higher = slower + more expensive)
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=medium

# API base URL — only change this if you route through a proxy/gateway.
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Database (Turso / libsql) ──────────────────────────────────────────────
# All server-side state (reward image records, generation status, player
# profiles) lives in one libsql database. Set both TURSO_* values to use Turso;
# leave them unset to fall back to a local SQLite file for development.
#
# Turso: create a database (`turso db create dino-division`), then
#   turso db show dino-division --url      → TURSO_DATABASE_URL
#   turso db tokens create dino-division   → TURSO_AUTH_TOKEN
# The schema is created automatically on first connection.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Local fallback (used only when TURSO_DATABASE_URL is unset). Files always live
# under <repo-root>/.sqlite/. A `file:/abs/path.sqlite3` TURSO_DATABASE_URL also
# works as an explicit local override (tests use this).
# SQLITE_DB_FILE=division-challenge.sqlite3

# ─── Reward image storage (Cloudflare R2) ───────────────────────────────────
# Every generated reward image is uploaded to R2 (S3-compatible API) and
# recorded in the database. Create an R2 bucket + an API token with
# "Object Read & Write" on it in the Cloudflare dashboard (R2 → Manage R2 API
# Tokens). R2_ACCOUNT_ID is the 32-char account id shown on the R2 overview.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=dino-division-rewards

# Optional. Public URL the bucket is exposed at (custom domain or the r2.dev
# public URL from the bucket's Settings → Public access). When set, image URLs
# handed to the browser point straight at R2 (fast, CDN-cached) and next.config
# allow-lists the host for next/image — so it must be present at BUILD time as
# well as at runtime. When unset, images are streamed through the app at
# /rewards/<slug>.<ext> (works everywhere, slower).
# R2_PUBLIC_BASE_URL=https://rewards.example.com

# Optional. S3 endpoint override (default https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
# and object key prefix inside the bucket (default "rewards").
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_KEY_PREFIX=rewards

# When the R2_* variables are absent the app stores images on local disk under
# <repo-root>/.reward-images/ (dev only) — override that directory here.
# REWARD_IMAGE_STORAGE_DIRECTORY=.reward-images

# ─── Next.js dev server ─────────────────────────────────────────────────────
# Build/dev output directory. Give every concurrently running `next dev` its own
# value to avoid lock collisions on .next/dev/lock (see AGENTS.md), e.g.
#   NEXT_DIST_DIR=.next-dev-3000 npm run dev -- --port 3000
# Usually passed inline rather than set here.
# NEXT_DIST_DIR=.next
